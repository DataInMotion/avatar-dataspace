{
  ":configurator:resource-version": 1,
  
	"org.apache.felix.http~httpHIMSA":
	{
		"org.osgi.service.http.port": "8088",
		"org.osgi.service.http.host": "localhost",
		"org.apache.felix.http.context_path": "/himsa",
		"org.apache.felix.http.name": "HimsaHTTP",
		"org.apache.felix.http.runtime.init.id": "httpHIMSA"
	},
	"JakartarsServletWhiteboardRuntimeComponent~restHIMSA":
	{
		"jersey.jakartars.whiteboard.name" : "HimsaREST",
		"jersey.context.path" : "rest",
		"osgi.http.whiteboard.target" : "(id=httpHIMSA)"
	},
	"EMFMongoRepositoryConfigurator": 
    {
        "mongo.instances": "avatar",
        "avatar.baseUris": "mongodb://mongodb:27017",
        "avatar.databases": "avatar",
        "avatar.avatar.repoType": "PROTOTYPE"
  	},
  	"GICSService~test":
  	{
  		"url": "http://localhost:8087/gics/gicsService"
  	},
  	"HIMSAConsentManagement": {
  		"consent.domain.id": "avatar",
  		"consent.policy.id": "hearing_policy",
  		"consent.policy.version": "1.0",
  		"consent.id.type": "Patient ID"
  	},
  	"DataLoadOptions": {
  		"collection.name": "Patient"
  	}, 
  	"DataStorageService~json": {
  		"data.format": "json", 
  		"data.storage.folder": "data",
  		"rsFactory.target": "(emf.fileExtension=json)"
  	},
  	"DataStorageService~xml": {
  		"data.format": "xml", 
  		"data.storage.folder": "data",
  		"rsFactory.target": "(emf.fileExtension=xml)"
  	}
}
