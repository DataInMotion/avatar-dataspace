-include: 	-secrets.bndrun

-runfw: org.apache.felix.framework;version='[7.0.5,7.0.5]'
-runee: JavaSE-17
# Avoid To have the default Jetty run at port 8080	
-runproperties: \
	org.osgi.service.http.port=-1,\
	felix.cm.config.plugins=org.apache.felix.configadmin.plugin.interpolation,\
	data=/opt/avatar/data/

-runrequires.system: \
	bnd.identity;id='org.apache.felix.configadmin.plugin.interpolation'
	
-runrequires: \
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.gogo.shell',\
	bnd.identity;id='org.avatar.himsa.dummy.data.component',\
	bnd.identity;id='org.avatar.other.rest',\
	bnd.identity;id='org.avatar.other.runtime.config',\
	bnd.identity;id='org.avatar.himsa.patient.service',\
	bnd.identity;id='org.avatar.other.backend',\
	bnd.identity;id='de.avatar.connector.cleanup.impl'
